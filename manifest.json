{
  "format": 1,
  "name": "tasks",
  "version": "0.2.0",
  "min_installer": "0.4.0",
  "description": "Lossless, exhaustive compiler from authoritative goals and source material into bite-sized actionable task graphs.",
  "skill_files": [
    "SKILL.md"
  ],
  "harness_resources": {
    "codex": {
      "agents": [
        "agents/codex/tasks-designer.toml",
        "agents/codex/tasks-reviewer.toml"
      ]
    },
    "claude": {
      "agents": [
        "agents/claude/tasks-designer.md",
        "agents/claude/tasks-reviewer.md"
      ]
    }
  },
  "instruction_fragment": "AGENTS.md",
  "generated_cleanup": [
    {
      "kind": "beads-metadata",
      "description": "Beads tasks/issues generated from a goal/intent",
      "metadata_key": "jls-tasks",
      "metadata_value": "owned"
    }
  ]
}
